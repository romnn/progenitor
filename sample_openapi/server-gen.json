{
  "openapi": "3.0.3",
  "info": {
    "title": "ServerGen",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "list_items",
        "summary": "List items, optionally limited.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "x-trace",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemList"
                }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_item",
        "summary": "Create an item (JSON body, 201 with no content).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/items/{itemId}": {
      "get": {
        "operationId": "get_item",
        "summary": "Fetch one item by id.",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "update_item",
        "summary": "Update an item (path + query + JSON body).",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dryRun",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/collide/{inner}": {
      "get": {
        "operationId": "collide",
        "summary": "Params named like the framework bindings, plus a required array query.",
        "parameters": [
          {
            "name": "inner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meta",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/blob": {
      "get": {
        "operationId": "download_blob",
        "summary": "Raw octet-stream response body.",
        "responses": {
          "200": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/multi/{mode}": {
      "get": {
        "operationId": "multi_kind",
        "summary": "Mixed JSON/raw success and error responses.",
        "parameters": [
          {
            "name": "mode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "206": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "exact typed error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "4XX": {
            "description": "typed error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "raw error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/upload/{file}": {
      "post": {
        "operationId": "upload_item",
        "summary": "Upload typed multipart fields.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "multipart_file_part",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "rating"
                ],
                "properties": {
                  "file": {
                    "description": "The primary upload.",
                    "type": "string",
                    "format": "binary"
                  },
                  "note": {
                    "description": "A note stored with the upload.",
                    "type": "string"
                  },
                  "rating": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "url": {
                    "description": "A field named like the generated request URL local.",
                    "type": "string"
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "legacy": {
                    "$ref": "#/components/schemas/DoesNotExist"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/upload-raw": {
      "post": {
        "operationId": "upload_raw",
        "summary": "Keep schema-less multipart as a raw body.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {}
          }
        },
        "responses": {
          "204": {
            "description": "uploaded"
          }
        }
      }
    },
    "/render-rejection": {
      "post": {
        "operationId": "render_rejection",
        "summary": "An operation whose name collides with the service rejection hook.",
        "responses": {
          "204": {
            "description": "rendered"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "deep_search",
        "summary": "deepObject query params are emitted as a 501 server stub.",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemList"
                }
              }
            }
          }
        }
      }
    },
    "/upgrade": {
      "get": {
        "operationId": "do_upgrade",
        "summary": "An upgrade endpoint \u2014 generates a 501 route stub, no trait method.",
        "responses": {
          "101": {
            "description": "switching protocols"
          }
        }
      }
    },
    "/files/{fileId}.json": {
      "get": {
        "operationId": "suffix_after_param",
        "summary": "Path axum cannot route: literal suffix after a parameter.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    },
    "/shape/{first}": {
      "get": {
        "operationId": "shape_by_first",
        "summary": "Shape shared with /shape/{second} via a different method.",
        "parameters": [
          {
            "name": "first",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    },
    "/shape/{second}": {
      "post": {
        "operationId": "shape_by_second",
        "summary": "Same shape as /shape/{first}, different method: merges.",
        "parameters": [
          {
            "name": "second",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    },
    "/shape/{third}": {
      "get": {
        "operationId": "shape_by_third",
        "summary": "Same shape AND method as /shape/{first}: dropped.",
        "parameters": [
          {
            "name": "third",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    },
    "/repeat/{outer}/mid/{inner}/tail/{outer}": {
      "get": {
        "operationId": "repeated_path_param",
        "summary": "Template names the same path parameter twice.",
        "parameters": [
          {
            "name": "outer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ItemList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Item"
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "openapi": "3.0.3",
  "info": {
    "title": "ServerGen",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "list_items",
        "summary": "List items, optionally limited.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "x-trace",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemList" }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_item",
        "summary": "Create an item (JSON body, 201 with no content).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Item" }
            }
          }
        },
        "responses": {
          "201": { "description": "created" },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/items/{itemId}": {
      "get": {
        "operationId": "get_item",
        "summary": "Fetch one item by id.",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "update_item",
        "summary": "Update an item (path + query + JSON body).",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dryRun",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Item" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          },
          "default": {
            "description": "error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/collide/{inner}": {
      "get": {
        "operationId": "collide",
        "summary": "Params named like the framework bindings, plus a required array query.",
        "parameters": [
          {
            "name": "inner",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "meta",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "tags",
            "in": "query",
            "required": true,
            "schema": { "type": "array", "items": { "type": "string" } }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          }
        }
      }
    },
    "/blob": {
      "get": {
        "operationId": "download_blob",
        "summary": "Raw octet-stream response body.",
        "responses": {
          "200": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    },
    "/multi/{mode}": {
      "get": {
        "operationId": "multi_kind",
        "summary": "Mixed JSON/raw success and error responses.",
        "parameters": [
          {
            "name": "mode",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "message",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" }
              }
            }
          },
          "206": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": {
            "description": "exact typed error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "4XX": {
            "description": "typed error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "default": {
            "description": "raw error",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/render-rejection": {
      "post": {
        "operationId": "render_rejection",
        "summary": "An operation whose name collides with the service rejection hook.",
        "responses": {
          "204": { "description": "rendered" }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "deep_search",
        "summary": "deepObject query params are emitted as a 501 server stub.",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemList" }
              }
            }
          }
        }
      }
    },
    "/upgrade": {
      "get": {
        "operationId": "do_upgrade",
        "summary": "An upgrade endpoint — generates a 501 route stub, no trait method.",
        "responses": {
          "101": { "description": "switching protocols" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "ItemList": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/Item" }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
